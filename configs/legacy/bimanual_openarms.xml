<mujoco model="bimanual_openarms">
  <compiler angle="radian" coordinate="local" meshdir="assets"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <joint damping="0.5" armature="0.02" frictionloss="0.1"/>
    <geom contype="1" conaffinity="1" condim="3" friction="1.0 0.05 0.001" rgba="0.8 0.8 0.85 1.0"/>
    <position kp="40" kv="4"/>
  </default>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="plane_tex" type="2d" builtin="checker" rgb1="0.2 0.25 0.3" rgb2="0.3 0.35 0.4" width="512" height="512" mark="cross" markrgb="0.8 0.8 0.8"/>
    <material name="plane_mat" texture="plane_tex" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="torso_mat" rgba="0.15 0.18 0.22 1.0"/>
    <material name="left_arm_mat" rgba="0.2 0.55 0.9 1.0"/>
    <material name="right_arm_mat" rgba="0.9 0.4 0.2 1.0"/>
    <material name="joint_mat" rgba="0.1 0.1 0.1 1.0"/>
    <material name="gripper_mat" rgba="0.3 0.3 0.3 1.0"/>
    <material name="table_mat" rgba="0.75 0.75 0.75 1.0"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="3 3 0.1" material="plane_mat"/>

    <!-- Workstation Table -->
    <body name="table" pos="0.5 0 0.4">
      <geom name="table_top" type="box" size="0.45 0.65 0.02" material="table_mat"/>
      <geom name="table_leg1" type="cylinder" size="0.03 0.2" pos="0.38 0.58 -0.2" material="torso_mat"/>
      <geom name="table_leg2" type="cylinder" size="0.03 0.2" pos="-0.38 0.58 -0.2" material="torso_mat"/>
      <geom name="table_leg3" type="cylinder" size="0.03 0.2" pos="0.38 -0.58 -0.2" material="torso_mat"/>
      <geom name="table_leg4" type="cylinder" size="0.03 0.2" pos="-0.38 -0.58 -0.2" material="torso_mat"/>
    </body>

    <!-- Central Torso / Mount Base -->
    <body name="robot_pedestal" pos="0 0 0.45">
      <geom name="base_post" type="box" size="0.1 0.25 0.15" material="torso_mat"/>

      <!-- ================= LEFT OPENARM ================= -->
      <body name="left_arm_base" pos="0 0.22 0.15" euler="0 0 0.26">
        <geom name="left_base_geom" type="cylinder" size="0.045 0.04" material="joint_mat"/>

        <body name="left_shoulder_link" pos="0 0 0.06">
          <joint name="left_joint1" type="hinge" axis="0 0 1" range="-2.6 2.6"/>
          <geom name="left_s_geom" type="capsule" size="0.035 0.04" material="left_arm_mat"/>

          <body name="left_upper_arm" pos="0 0.04 0.08">
            <joint name="left_joint2" type="hinge" axis="0 1 0" range="-1.8 1.8"/>
            <geom name="left_ua_geom" type="capsule" fromto="0 0 0 0.18 0 0.18" size="0.03" material="left_arm_mat"/>

            <body name="left_forearm" pos="0.18 0 0.18">
              <joint name="left_joint3" type="hinge" axis="0 1 0" range="-2.2 2.2"/>
              <geom name="left_fa_geom" type="capsule" fromto="0 0 0 0.18 0 -0.02" size="0.028" material="left_arm_mat"/>

              <body name="left_wrist_pitch_link" pos="0.18 0 -0.02">
                <joint name="left_joint4" type="hinge" axis="0 1 0" range="-1.8 1.8"/>
                <geom name="left_wp_geom" type="sphere" size="0.025" material="joint_mat"/>

                <body name="left_wrist_roll_link" pos="0.05 0 0">
                  <joint name="left_joint5" type="hinge" axis="1 0 0" range="-2.9 2.9"/>
                  <geom name="left_wr_geom" type="cylinder" size="0.022 0.025" zaxis="1 0 0" material="left_arm_mat"/>

                  <!-- Left End-Effector / Gripper -->
                  <body name="left_gripper_base" pos="0.05 0 0">
                    <geom name="left_palm" type="box" size="0.015 0.035 0.015" material="gripper_mat"/>
                    <site name="left_ee" pos="0.06 0 0" size="0.01" rgba="1 0 0 1"/>

                    <!-- Gripper fingers -->
                    <body name="left_finger_left" pos="0.03 0.025 0">
                      <joint name="left_gripper_joint" type="slide" axis="0 1 0" range="-0.035 0"/>
                      <geom name="left_fg1" type="box" size="0.025 0.005 0.012" material="gripper_mat"/>
                    </body>
                    <body name="left_finger_right" pos="0.03 -0.025 0">
                      <joint name="left_gripper_joint_sym" type="slide" axis="0 1 0" range="0 0.035"/>
                      <geom name="left_fg2" type="box" size="0.025 0.005 0.012" material="gripper_mat"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ================= RIGHT OPENARM ================= -->
      <body name="right_arm_base" pos="0 -0.22 0.15" euler="0 0 -0.26">
        <geom name="right_base_geom" type="cylinder" size="0.045 0.04" material="joint_mat"/>

        <body name="right_shoulder_link" pos="0 0 0.06">
          <joint name="right_joint1" type="hinge" axis="0 0 1" range="-2.6 2.6"/>
          <geom name="right_s_geom" type="capsule" size="0.035 0.04" material="right_arm_mat"/>

          <body name="right_upper_arm" pos="0 -0.04 0.08">
            <joint name="right_joint2" type="hinge" axis="0 1 0" range="-1.8 1.8"/>
            <geom name="right_ua_geom" type="capsule" fromto="0 0 0 0.18 0 0.18" size="0.03" material="right_arm_mat"/>

            <body name="right_forearm" pos="0.18 0 0.18">
              <joint name="right_joint3" type="hinge" axis="0 1 0" range="-2.2 2.2"/>
              <geom name="right_fa_geom" type="capsule" fromto="0 0 0 0.18 0 -0.02" size="0.028" material="right_arm_mat"/>

              <body name="right_wrist_pitch_link" pos="0.18 0 -0.02">
                <joint name="right_joint4" type="hinge" axis="0 1 0" range="-1.8 1.8"/>
                <geom name="right_wp_geom" type="sphere" size="0.025" material="joint_mat"/>

                <body name="right_wrist_roll_link" pos="0.05 0 0">
                  <joint name="right_joint5" type="hinge" axis="1 0 0" range="-2.9 2.9"/>
                  <geom name="right_wr_geom" type="cylinder" size="0.022 0.025" zaxis="1 0 0" material="right_arm_mat"/>

                  <!-- Right End-Effector / Gripper -->
                  <body name="right_gripper_base" pos="0.05 0 0">
                    <geom name="right_palm" type="box" size="0.015 0.035 0.015" material="gripper_mat"/>
                    <site name="right_ee" pos="0.06 0 0" size="0.01" rgba="0 1 0 1"/>

                    <!-- Gripper fingers -->
                    <body name="right_finger_left" pos="0.03 0.025 0">
                      <joint name="right_gripper_joint" type="slide" axis="0 1 0" range="-0.035 0"/>
                      <geom name="right_fg1" type="box" size="0.025 0.005 0.012" material="gripper_mat"/>
                    </body>
                    <body name="right_finger_right" pos="0.03 -0.025 0">
                      <joint name="right_gripper_joint_sym" type="slide" axis="0 1 0" range="0 0.035"/>
                      <geom name="right_fg2" type="box" size="0.025 0.005 0.012" material="gripper_mat"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Target manipulation object on table -->
    <body name="manip_cube" pos="0.45 0 0.44">
      <joint name="cube_joint" type="free"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" rgba="0.95 0.8 0.2 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Left Arm Actuators -->
    <position name="left_act1" joint="left_joint1" kp="80" kv="6"/>
    <position name="left_act2" joint="left_joint2" kp="80" kv="6"/>
    <position name="left_act3" joint="left_joint3" kp="60" kv="5"/>
    <position name="left_act4" joint="left_joint4" kp="40" kv="3"/>
    <position name="left_act5" joint="left_joint5" kp="30" kv="2"/>
    <position name="left_act_gripper" joint="left_gripper_joint" kp="100" kv="10"/>

    <!-- Right Arm Actuators -->
    <position name="right_act1" joint="right_joint1" kp="80" kv="6"/>
    <position name="right_act2" joint="right_joint2" kp="80" kv="6"/>
    <position name="right_act3" joint="right_joint3" kp="60" kv="5"/>
    <position name="right_act4" joint="right_joint4" kp="40" kv="3"/>
    <position name="right_act5" joint="right_joint5" kp="30" kv="2"/>
    <position name="right_act_gripper" joint="right_gripper_joint" kp="100" kv="10"/>
  </actuator>

  <equality>
    <joint joint1="left_gripper_joint" joint2="left_gripper_joint_sym" polycoef="0 -1 0 0 0"/>
    <joint joint1="right_gripper_joint" joint2="right_gripper_joint_sym" polycoef="0 -1 0 0 0"/>
  </equality>
</mujoco>
